{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:alpha-radar": "node scripts/test-alpha-radar.mjs",
    "test:market-feed": "node scripts/test-market-feed.mjs",
    "test:data-governance": "node scripts/test-data-governance.mjs",
    "test:engineering-governance": "node scripts/test-engineering-governance.mjs",
    "test:internal-task-registry": "node scripts/test-internal-task-registry.mjs",
    "test:backend-lifeline": "node scripts/test-backend-lifeline.mjs",
    "test:runtime-supervisor": "node scripts/test-runtime-supervisor.mjs",
    "test:autonomous-operations": "node scripts/test-autonomous-operations-coordinator.mjs",
    "test:autonomous-operations-schema": "node scripts/test-autonomous-operations-schema.mjs",
    "test:server-lifecycle": "node scripts/test-server-lifecycle.mjs",
    "test:runtime-supervisor-schema": "node scripts/test-runtime-supervisor-schema.mjs",
    "test:lifeline-restart": "node scripts/test-lifeline-restart.mjs",
    "test:radar-stream-recovery": "node scripts/test-radar-stream-recovery.mjs",
    "test:databento-live": "node scripts/test-databento-live.mjs",
    "test:opening-readiness": "node scripts/test-opening-readiness.mjs",
    "test:catalyst-radar": "node scripts/test-catalyst-radar.mjs",
    "test:focused-scan-routing": "node scripts/test-focused-scan-routing.mjs",
    "test:signal-validation": "node scripts/test-signal-validation.mjs",
    "test:shadow-learning": "node scripts/test-shadow-learning.mjs",
    "test:signal-validation-db": "node scripts/test-signal-validation-db.mjs",
    "test:alert-monitor": "node scripts/test-alert-monitor.mjs",
    "test:alert-service": "node scripts/test-alert-service.mjs",
    "test:sector-priority": "node scripts/test-sector-priority.mjs",
    "test:ai-industry-stock-pool": "node scripts/test-ai-industry-stock-pool.mjs",
    "test:research-sidecar": "node scripts/test-research-sidecar.mjs",
    "test:aiceo-control-plane": "node scripts/test-aiceo-control-plane.mjs",
